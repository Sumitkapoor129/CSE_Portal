PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/cse_portal

JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

